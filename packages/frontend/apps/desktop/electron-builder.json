{
  "appId": "com.mydoc.repository",
  "productName": "MyDoc",
  "directories": {
    "buildResources": "resources",
    "output": "../../../../release/desktop"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [{"from":"resources/uninstall-macos.sh","to":"uninstall-macos.sh"}],
  "asar": true,
  "npmRebuild": false,
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "beforePack": "../../../../scripts/desktop/verify-electron-runtime.cjs",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "mac": {
    "identity": "-",
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "MyDoc 需要连接你指定的局域网工作空间服务器，以登录和同步团队文档。"
    },
    "icon": "resources/icon.icns",
    "category": "public.app-category.productivity",
    "target": [
      "dmg",
      "zip"
    ],
    "hardenedRuntime": false,
    "notarize": false,
    "minimumSystemVersion": "13.0"
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true
  },
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown"
      ],
      "name": "Markdown \u6587\u6863",
      "description": "Markdown \u6587\u6863",
      "mimeType": "text/markdown",
      "role": "Editor"
    }
  ],
  "protocols": [
    {
      "name": "MyDoc \u6587\u6863\u94fe\u63a5",
      "schemes": [
        "mydoc"
      ],
      "role": "Viewer"
    }
  ],
  "publish": [{"provider":"github","owner":"remixmessi","repo":"MyDocRepository","releaseType":"release"}],
  "afterPack": "../../../../scripts/desktop/verify-mac-architecture.cjs"
}
